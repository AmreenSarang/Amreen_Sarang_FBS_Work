from abc import ABC, abstractmethod
class Vehicle(ABC):
    def __init__(self, persons):
        self.persons = persons

    @abstractmethod
    def calToll(self):
        pass

    def __str__(self):
        return f"Persons = {self.persons}"

class TwoWheeler(Vehicle):
    def calToll(self):
        toll = 20
        if self.persons > 2:
            toll += (self.persons - 2) * 10
        return toll

    def __str__(self):
        return super().__str__() + f" Total Toll = {self.calToll()}"

class ThreeWheeler(Vehicle):
    def calToll(self):
        toll = 30
        if self.persons > 3:
            toll += (self.persons - 3) * 20
        return toll

    def __str__(self):
        return super().__str__() + f" Total Toll = {self.calToll()}"

