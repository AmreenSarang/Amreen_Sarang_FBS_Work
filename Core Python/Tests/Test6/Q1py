class HeavyVehicle(Vehicle):
    def calToll(self):
        toll = 60
        if self.persons > 6:
            toll += (self.persons - 6) * 100
        return toll

    def __str__(self):
        return super().__str__() + f" Total Toll = {self.calToll()}"

t = TwoWheeler(3)
th = ThreeWheeler(4)
f = FourWheeler(5)
h = HeavyVehicle(8)

print(t)
print(th)
print(f)
print(h)